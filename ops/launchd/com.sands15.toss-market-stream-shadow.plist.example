<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TOSS_STREAM_CONTEXT_PATH</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/news-context.json</string>
    <key>TOSS_STREAM_EXPERIMENT_HASH</key>
    <string>REPLACE_WITH_64_LOWERCASE_HEX_EXPERIMENT_HASH</string>
    <key>TOSS_STREAM_HEARTBEAT_PATH</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/heartbeats/stream/heartbeat.json</string>
    <key>TOSS_STREAM_KEYCHAIN_SLUG</key>
    <string>REPLACE_WITH_USER_SLUG</string>
    <key>TOSS_STREAM_SNAPSHOT_PATH</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/market-stream.json</string>
    <key>TOSS_STREAM_SIMULATION_CONFIG_PATH</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/stream/intraday-simulation.yaml</string>
    <key>TOSS_STREAM_SIMULATION_DB</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/intraday-paper.sqlite3</string>
    <key>TOSS_STREAM_SIMULATION_END_DATE</key>
    <string>2026-09-30</string>
    <key>TOSS_STREAM_SIMULATION_ID</key>
    <string>2026-09-forward-test</string>
    <key>TOSS_STREAM_SIMULATION_START_DATE</key>
    <string>2026-08-31</string>
    <key>TOSS_STREAM_PLAN_DB</key>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/intraday.sqlite3</string>
  </dict>
  <key>Label</key>
  <string>com.sands15.toss-market-stream-shadow</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/READ_ONLY/RELEASE/REPLACE_WITH_EXACT_COMMIT_SHA/ops/run-toss-stream.command</string>
  </array>
  <key>StandardErrorPath</key>
  <string>/ABSOLUTE/PRIVATE/RUNTIME/market-stream.stderr.log</string>
  <key>StandardOutPath</key>
  <string>/ABSOLUTE/PRIVATE/RUNTIME/market-stream.stdout.log</string>
  <key>WatchPaths</key>
  <array>
    <string>/ABSOLUTE/PRIVATE/RUNTIME/news-context.json</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>WorkingDirectory</key>
  <string>/ABSOLUTE/READ_ONLY/RELEASE/REPLACE_WITH_EXACT_COMMIT_SHA</string>
</dict>
</plist>
